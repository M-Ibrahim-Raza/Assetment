{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./tasks.md)",
      "Edit(./tasks.md)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/*.pem)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-and-lint.mjs\"",
            "timeout": 60,
            "statusMessage": "ESLint and Prettier on the edited file"
          }
        ]
      }
    ]
  }
}
