{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // `@/` means the repo root, as in production, so reused Views resolve. `@proto/` is this folder.
    "paths": {
      "@/*": ["../*"],
      "@proto/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
